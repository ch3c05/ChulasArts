{
  "name": "chulasarts",
  "version": "0.1.0",
  "private": true,
  "description": "Art portfolio management platform",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:local --workspace=backend\" \"npm run dev:local --workspace=frontend\"",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.0",
    "prettier": "^3.1.1"
  },
  "lint-staged": {
    "backend/**/*.{ts,tsx,js,jsx}": [
      "cd backend && eslint --fix",
      "prettier --write"
    ],
    "frontend/**/*.{ts,tsx,js,jsx}": [
      "cd frontend && eslint --fix",
      "prettier --write"
    ],
    "**/*.{json,css,md}": [
      "prettier --write"
    ]
  }
}
